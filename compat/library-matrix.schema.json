{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "minimum": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "recommended": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "latest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "legacy": {
      "const": "supported"
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "revisions": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "released": {
            "type": ["string", "null"],
            "format": "date"
          },
          "minServer": {
            "type": ["string", "null"]
          },
          "status": {
            "enum": [
              "supported",
              "deprecated",
              "unsupported"
            ]
          }
        },
        "required": [
          "version",
          "status"
        ]
      }
    },
    "deprecated": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "range": {
            "type": "string",
            "minLength": 1
          },
          "announced": {
            "type": "string",
            "format": "date"
          },
          "successorReleased": {
            "type": "string",
            "format": "date"
          },
          "sunset": {
            "type": "string",
            "format": "date"
          },
          "replacement": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "required": [
          "range",
          "announced",
          "successorReleased",
          "sunset",
          "replacement",
          "issue"
        ]
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "range": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "advisory": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "required": [
          "range",
          "reason",
          "advisory"
        ]
      }
    },
    "tested": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "server": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "serverCommit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "library": {
            "type": "string"
          },
          "revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "engine": {
            "type": "string",
            "minLength": 1
          },
          "database": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "sqlite",
                "postgres"
              ]
            }
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "ci-only"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "required": [
          "server",
          "serverCommit",
          "library",
          "revision",
          "engine",
          "database",
          "result",
          "evidence"
        ]
      }
    },
    "knownBroken": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "engine": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "required": [
          "revision",
          "engine",
          "scope",
          "reason",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "minimum",
    "recommended",
    "latest",
    "legacy",
    "libraries",
    "deprecated",
    "blocked",
    "tested",
    "knownBroken"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
