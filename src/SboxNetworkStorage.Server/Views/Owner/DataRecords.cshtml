@model SboxNetworkStorage.Server.Owner.OwnerDataRecordsModel
@using SboxNetworkStorage.Server.Owner
@{
    Layout = "~/Views/Owner/_Layout.cshtml";
    var collection = Model.Collection;
    var dataUrl = "/dashboard/projects/" + Uri.EscapeDataString(Model.ProjectId) + "/data";
    var url = OwnerDataController.CollectionUrl(Model.ProjectId, collection.Id);
    string PageUrl(int page) => $"{url}?page={page}&size={Model.PageSize}" + (Model.Query is null ? "" : "&q=" + Uri.EscapeDataString(Model.Query));
}
<div class="page-heading"><div><h1>@collection.Name</h1><p><code>@collection.Id</code> · @collection.Kind collection · @collection.RecordCount record(s)</p></div><div class="actions"><a class="button" href="@url/new">Create record</a><a class="button secondary" href="@url/export" download>Download JSON</a></div></div>
<section class="card">
    <form method="get" action="@url" class="search">
        <label>Key starts with <input name="q" value="@Model.Query" maxlength="@OwnerDataController.MaxQueryLength" autocomplete="off" placeholder="@(collection.Global ? "record id" : "Steam ID or record key")" /></label>
        <input type="hidden" name="size" value="@Model.PageSize" />
        <button type="submit">Search</button>
    </form>
    @if (Model.Query is not null)
    {
        <p>@Model.MatchCount match(es) for keys starting with <code>@Model.Query</code> · <a href="@url">Clear search</a></p>
    }
    @if (Model.Records.Count == 0)
    {
        if (Model.Query is not null) { <p>No keys start with <code>@Model.Query</code>. Keys are case-sensitive.</p> }
        else
        {
            <div class="empty-state">
                <h3>No records yet</h3>
                <p>@(collection.Global ? "Create the first global record here, or save one from an endpoint." : "Records appear when the game saves player data through an endpoint or the document API. You can also create one here.")</p>
                <div class="actions"><a class="button" href="@url/new">Create record</a><a class="button secondary" href="/dashboard/projects/@Uri.EscapeDataString(Model.ProjectId)/tests">Run an endpoint test</a></div>
            </div>
        }
    }
    else
    {
        <div class="table-scroll"><table data-sortable data-sort-scope="page">
            <thead><tr><th>Key</th><th>Version</th><th>Changed</th><th>Size</th><th>Preview</th></tr></thead>
            <tbody>
            @foreach (var record in Model.Records)
            {
                <tr>
                    <td><a href="@OwnerDataController.RecordUrl(Model.ProjectId, collection.Id, record.Key)"><code>@record.Key</code></a></td>
                    <td>@record.Version</td>
                    <td>@record.ChangedAt</td>
                    <td>@record.SizeBytes B</td>
                    <td><code class="preview">@record.Preview</code></td>
                </tr>
            }
            </tbody>
        </table></div>
    }
    <nav class="pager" aria-label="Pages">
        @if (Model.Page > 1) { <a class="button secondary" href="@PageUrl(Model.Page - 1)">Previous</a> }
        <span>Page @Model.Page of @Model.PageCount</span>
        @if (Model.Page < Model.PageCount) { <a class="button secondary" href="@PageUrl(Model.Page + 1)">Next</a> }
    </nav>
</section>
