@model SboxNetworkStorage.Server.Owner.OwnerResourceDetailModel
@using System.Text.Json
@using SboxNetworkStorage.Server.Owner
@{
    Layout = "~/Views/Owner/_Layout.cshtml";
    var url = "/dashboard/projects/" + Uri.EscapeDataString(Model.ProjectId);
    var baseUrl = url + "/resources/" + Model.Kind;
    var listUrl = baseUrl;
    var title = Model.Kind switch { "game-values" => "Game values", "query" => "Queries", _ => char.ToUpperInvariant(Model.Kind[0]) + Model.Kind[1..] + "s" };
    string TabUrl(string tab) => Model.IsDraft || Model.Id is null
        ? (Model.Kind == "game-values" ? baseUrl + "?tab=" + tab : baseUrl + "/new?draft=" + Uri.EscapeDataString(Model.Id ?? "") + (tab == "edit" ? "" : "&tab=" + tab))
        : baseUrl + "/" + Uri.EscapeDataString(Model.Id) + "?tab=" + tab;
    var isEdit = Model.Tab == "edit";
    var isCode = Model.Tab == "code";
    var isOverview = !isEdit && !isCode;
    string ErrorRate() => Model.Row is null || Model.Row.Calls == 0 ? "Never" : ((double)Model.Row.Errors / Model.Row.Calls).ToString("P1", System.Globalization.CultureInfo.InvariantCulture);
    string AvgMs() => Model.Row is null || Model.Row.Calls == 0 ? "Never" : ((double)Model.Row.DurationMsSum / Model.Row.Calls).ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + " ms";
    JsonElement Definition() => Model.DefinitionJson is { ValueKind: JsonValueKind.Object } d ? d : default;
    bool HasDefinition() => Model.DefinitionJson is { ValueKind: JsonValueKind.Object };
    string Text(JsonElement element, string name) => element.ValueKind == JsonValueKind.Object && element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : "";
    int StepCount() => HasDefinition() && Definition().TryGetProperty("steps", out var steps) && steps.ValueKind == JsonValueKind.Array ? steps.GetArrayLength() : 0;
}
<link rel="stylesheet" href="/owner-assets/m/manage.css" />
@if (isEdit)
{
    <link rel="stylesheet" href="/owner-assets/blocks.css" />
}
<div class="page-heading"><div><h1>@Model.Name</h1><p><code>@(Model.Id ?? Model.Kind)</code>@if (Model.IsDraft) { <span class="badge">Draft</span> }
@if (Model.Kind == "endpoint" && Model.Row is not null) { <span class="badge">@Model.Row.Method</span> <span class="badge @((Model.Row.Enabled ?? true) ? "positive" : "")">@((Model.Row.Enabled ?? true) ? "Enabled" : "Disabled")</span> <span class="badge">@Model.Row.Access</span> }
else if (Model.Kind == "collection" && Model.Row is not null) { <span class="badge">@Model.Row.Storage</span> <span class="badge">@Model.Row.ClientAccess</span> }
else if (Model.Kind == "query" && Model.Row is not null) { <span class="badge">@Model.Row.QueryType</span> }</p></div>
<div class="page-actions">
@if (Model.Integration?.TestUrl is not null) { <a class="button secondary" href="@Model.Integration.TestUrl">Test</a> }
@if (Model.Integration?.VersionsUrl is not null) { <a class="button secondary" href="@Model.Integration.VersionsUrl">History</a> }
@if (Model.Integration?.DataUrl is not null) { <a class="button secondary" href="@Model.Integration.DataUrl">Browse records</a> }
<a class="button secondary" href="@listUrl">All @title.ToLowerInvariant()</a>
</div></div>
@if (Model.Error is not null) { <div class="notice error" role="alert"><strong>Could not save this definition</strong><pre>@Model.Error</pre><p>Correct the reported field or source syntax and save again. Your input has been preserved.</p></div> }
@if (Model.Diagnostics is { Count: > 0 } diagnostics)
{
    <div class="notice error" role="alert"><strong>Could not save this definition</strong><p>Fix the errors below and save again. Your input has been preserved.</p>
    <ul>@foreach (var item in diagnostics) { <li>@(item.IsError ? "Error" : "Warning") @item.Code at @item.Path: @item.Message</li> }</ul></div>
}
<nav class="resource-tabs" aria-label="Resource sections">
    <a href="@TabUrl("overview")" aria-current="@(isOverview ? "page" : null)" data-resource-tab>Overview</a>
    <a href="@TabUrl("edit")" aria-current="@(isEdit ? "page" : null)" data-resource-tab>Edit</a>
    <a href="@TabUrl("code")" aria-current="@(isCode ? "page" : null)" data-resource-tab>Code</a>
</nav>
@if (isOverview)
{
    <section class="grid stat-tiles">
    @if (Model.Kind == "endpoint" && Model.Row is not null)
    {
        <article class="card metric"><span>Calls (this month)</span><strong>@Model.Row.Calls</strong></article>
        <article class="card metric"><span>Errors</span><strong>@Model.Row.Errors</strong></article>
        <article class="card metric"><span>Error rate</span><strong>@ErrorRate()</strong></article>
        <article class="card metric"><span>Avg ms</span><strong>@AvgMs()</strong></article>
        <article class="card metric"><span>Method</span><strong>@Model.Row.Method</strong></article>
        <article class="card metric"><span>Status</span><strong>@((Model.Row.Enabled ?? true) ? "Enabled" : "Disabled")</strong></article>
        <article class="card metric"><span>Steps</span><strong>@Model.Row.Steps</strong></article>
        <article class="card metric"><span>Access</span><strong>@Model.Row.Access</strong></article>
    }
    else if (Model.Kind == "collection" && Model.Row is not null)
    {
        <article class="card metric"><span>Records</span><strong>@(Model.Row.Records?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Never")</strong></article>
        <article class="card metric"><span>Fields</span><strong>@Model.Row.Fields</strong></article>
        <article class="card metric"><span>Storage</span><strong>@Model.Row.Storage</strong></article>
        <article class="card metric"><span>Client access</span><strong>@Model.Row.ClientAccess</strong></article>
    }
    else if (Model.Kind == "workflow" && Model.Row is not null)
    {
        <article class="card metric"><span>Steps</span><strong>@Model.Row.WorkflowSteps</strong></article>
        <article class="card metric"><span>Parameters</span><strong>@Model.Row.Parameters</strong></article>
    }
    else if (Model.Kind == "query" && Model.Row is not null)
    {
        <article class="card metric"><span>Last run</span><strong>@(Model.Row.LastRun ?? "Never")</strong></article>
        <article class="card metric"><span>Duration</span><strong>@(Model.Row.DurationMs is null ? "Never" : Model.Row.DurationMs.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) + " ms")</strong></article>
        <article class="card metric"><span>Records</span><strong>@(Model.Row.RecordsReturned?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Never")</strong></article>
        <article class="card metric"><span>Type</span><strong>@Model.Row.QueryType</strong></article>
        <article class="card metric"><span>Sources</span><strong>@Model.Row.Sources</strong></article>
    }
    else if (Model.Kind == "game-values")
    {
        <article class="card metric"><span>Groups and tables</span><strong>@(HasDefinition() && Definition().TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array ? items.GetArrayLength().ToString(System.Globalization.CultureInfo.InvariantCulture) : "0")</strong></article>
    }
    </section>
    <section class="card">
        <h2>Definition preview</h2>
        <p class="muted">Read-only outline of the saved source. Edit it under the Edit tab.</p>
        @if (HasDefinition())
        {
            var definition = Definition();
            if (Model.Kind == "endpoint")
            {
                <ul class="rows">
                    <li><span class="row-label">Method</span><span class="row-value">@Text(definition, "method")</span></li>
                    <li><span class="row-label">Enabled</span><span class="row-value">@(definition.TryGetProperty("enabled", out var enabled) && enabled.ValueKind == JsonValueKind.False ? "Disabled" : "Enabled")</span></li>
                    <li><span class="row-label">Steps (@StepCount())</span><span class="row-value">@if (definition.TryGetProperty("steps", out var steps) && steps.ValueKind == JsonValueKind.Array) { <ul>@foreach (var step in steps.EnumerateArray()) { var stepId = Text(step, "id"); var stepType = Text(step, "type"); var target = Text(step, "collection") is { Length: > 0 } collection ? collection : Text(step, "workflow") is { Length: > 0 } workflow ? workflow : Text(step, "expression"); <li><code>@stepId</code> @stepType@if (target.Length > 0) { <span class="muted">@target</span> }</li> }</ul> } else { <span class="muted">None</span> }</span></li>
                </ul>
            }
            else if (Model.Kind == "collection")
            {
                <ul class="rows">
                    <li><span class="row-label">Storage</span><span class="row-value">@Text(definition, "collectionType")</span></li>
                    <li><span class="row-label">Client access</span><span class="row-value">@Text(definition, "accessMode")</span></li>
                    <li><span class="row-label">Fields</span><span class="row-value">@if (definition.TryGetProperty("schema", out var schema) && schema.ValueKind == JsonValueKind.Object && schema.TryGetProperty("properties", out var properties) && properties.ValueKind == JsonValueKind.Object) { <ul>@foreach (var field in properties.EnumerateObject()) { <li><code>@field.Name</code> <span class="muted">@Text(field.Value, "type")</span></li> }</ul> } else { <span class="muted">None</span> }</span></li>
                </ul>
            }
            else if (Model.Kind == "workflow")
            {
                <ul class="rows">
                    <li><span class="row-label">Parameters</span><span class="row-value">@(Model.Row?.Parameters ?? "None")</span></li>
                    <li><span class="row-label">Steps (@StepCount())</span><span class="row-value">@if (definition.TryGetProperty("steps", out var steps) && steps.ValueKind == JsonValueKind.Array) { <ul>@foreach (var step in steps.EnumerateArray()) { <li><code>@Text(step, "id")</code> @Text(step, "type")</li> }</ul> } else { <span class="muted">None</span> }</span></li>
                </ul>
            }
            else if (Model.Kind == "query")
            {
                <ul class="rows">
                    <li><span class="row-label">Type</span><span class="row-value">@Text(definition, "type")</span></li>
                    <li><span class="row-label">Sources</span><span class="row-value">@(Model.Row?.Sources ?? "None")</span></li>
                </ul>
            }
            else if (Model.Kind == "game-values")
            {
                if (definition.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array)
                {
                    <ul class="rows">@foreach (var item in items.EnumerateArray()) { <li><span class="row-label"><code>@Text(item, "id")</code></span><span class="row-value muted">@Text(item, "type")</span></li> }</ul>
                }
            }
        }
        <details><summary>Full source</summary><pre data-language="yaml">@Model.Definition</pre></details>
    </section>
}
else if (isEdit)
{
    <section class="card definition-panel">
    <div class="section-heading definition-heading">
        <h2>@(Model.IsDraft ? "Create definition" : "Edit definition")</h2>
        <div class="actions definition-actions"><span id="editor-state" class="muted" role="status">No unsaved changes</span><button type="button" class="secondary" id="builder-check">Check definition</button><button type="submit" form="resource-definition-form">Save live definition</button></div>
    </div>
    <p class="muted" id="definition-help">Build with editable blocks. Open a block to change its options; drag the handle or use the move buttons to reorder. Raw source is always available. Changes stay local until you save.</p>
    <div id="check-results" aria-live="polite"></div>
    <div class="workbench-tabs" role="tablist" aria-label="Definition editor">
        <button type="button" role="tab" id="edit-tab" aria-controls="definition-guided" aria-selected="true" data-editor-mode="edit">Guided editor</button>
        <button type="button" role="tab" id="raw-tab" aria-controls="definition-raw" aria-selected="false" tabindex="-1" data-editor-mode="raw">Raw source</button>
        <button type="button" role="tab" id="examples-tab" aria-controls="definition-examples" aria-selected="false" tabindex="-1" data-editor-mode="examples">Examples</button>
    </div>
    <div id="definition-guided" role="tabpanel" aria-labelledby="edit-tab" hidden>
        <div class="block-toolbar"><span class="muted">Click a block to edit its options.</span><div class="actions"><button type="button" class="secondary" id="blocks-expand">Expand all</button><button type="button" class="secondary" id="blocks-collapse">Collapse all</button></div></div>
        <p id="block-editor-status" class="muted" role="status"></p>
        <div id="block-editor" data-kind="@Model.Kind" data-context="@Model.BuilderContext"><p class="muted">Loading block editor...</p></div>
    </div>
    <div id="definition-raw" role="tabpanel" aria-labelledby="raw-tab">
    <noscript><p class="notice">JavaScript is required for the block editor. You can edit and save the complete source below.</p></noscript>
    <form id="resource-definition-form" method="post" action="@baseUrl">
    @Html.AntiForgeryToken()
    @if (Model.Id is not null && !Model.IsDraft && Model.Kind != "game-values") { <input type="hidden" name="id" value="@Model.Id" /> }
    <div class="source-heading"><label for="definition">Definition source</label><span class="muted" id="source-position">YAML</span></div>
    <textarea class="code-editor" id="definition" name="definition" rows="24" required spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" data-language="yaml" aria-describedby="definition-help definition-sync">@Model.Definition</textarea>
    <p class="muted definition-sync" id="definition-sync">Editor pushes can overwrite dashboard edits. Coordinate changes with your checked-in source.</p>
    </form></div>
    <div id="definition-examples" role="tabpanel" aria-labelledby="examples-tab">
    <p class="muted">Start with a complete definition. Replacing the source requires confirmation; saving is a separate action.</p>
    <div id="example-gallery"><p class="muted">Loading examples...</p></div>
    </div></section>
}
else if (isCode)
{
    @if (Model.Integration is not null)
    {
        @await Html.PartialAsync("~/Views/Owner/_ResourceIntegration.cshtml", Model.Integration)
    }
    else
    {
        <section class="card"><h2>Code</h2><p class="muted">No integration guide is available for this resource.</p></section>
    }
}
@if (Model.Kind != "game-values")
{
<dialog class="owner-dialog" id="new-resource" aria-labelledby="new-resource-title"><div class="owner-dialog-body"><h2 id="new-resource-title">New @Model.Kind</h2><p>Choose an id using letters, numbers, underscore or hyphen. A fresh draft opens with this id; nothing is published until you save.</p><label>Id <input id="new-resource-id" maxlength="128" placeholder="my-@Model.Kind" data-autofocus /></label><p class="muted" id="new-resource-status" aria-live="polite"></p><div class="owner-dialog-actions"><form method="dialog"><button type="submit" class="secondary" value="cancel">Cancel</button></form><button type="button" id="new-resource-confirm">Create draft</button></div></div></dialog>
<noscript><p><a class="button secondary" href="@baseUrl/new?draft=new-@Model.Kind">New @Model.Kind</a></p></noscript>
}
<script src="/owner-assets/m/manage.js" defer></script>
@if (isEdit)
{
<script src="/owner-assets/json-editor.js" defer></script>
<script src="/owner-assets/vendor/yaml.js" defer></script>
<script src="/owner-assets/definition-model.js" defer></script>
<script src="/owner-assets/blocks.js" defer></script>
<script src="/owner-assets/builder-catalog.js" defer></script>
}
